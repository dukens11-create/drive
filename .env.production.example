NODE_ENV=production
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info

# Generate strong unique values. Never commit real secrets.
JWT_SECRET=replace-with-production-secret
ADMIN_SEED_PASSWORD=replace-with-production-admin-password

# Durable production application state. Current v26 snapshot mode intentionally supports one backend replica.
DATA_STORE_MODE=postgres
DATABASE_URL=postgresql://user:password@host:5432/flupflap
DATABASE_POOL_MAX=10
REDIS_URL=redis://production-redis:6379

APP_BASE_URL=https://app.flupflap.com
CORS_ALLOWED_ORIGINS=https://app.flupflap.com,https://admin.flupflap.com

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

KYC_PROVIDER=persona
KYC_PROVIDER_API_KEY=
KYC_PROVIDER_WEBHOOK_SECRET=
KYC_TEMPLATE_ID=
KYC_PROVIDER_BASE_URL=https://api.withpersona.com

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=FlupFlap
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

MAPBOX_PUBLIC_TOKEN=
MAPBOX_API_KEY=
GOOGLE_PLACES_API_KEY=
POS_CREDENTIALS_ENCRYPTION_KEY=